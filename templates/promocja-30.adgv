{
  "format": "ADGV",
  "version": "1.0",
  "type": "template",

  "template": {
    "id": "premium-product-001",
    "name": "Premium Product",
    "description": "Dynamiczna 10-sekundowa reklama produktu",
    "author": "Tech Karol",
    "category": "product",
    "tags": [
      "product",
      "premium",
      "sale",
      "dynamic",
      "social-media"
    ],

    "duration": 10,
    "fps": 30,

    "canvas": {
      "width": 1080,
      "height": 1920,
      "aspectRatio": "9:16",
      "background": "#080808"
    }
  },

  "placeholders": [

    {
      "id": "mainVideo",
      "type": "video",
      "name": "Główne video",
      "description": "Dodaj swoje video produktu",
      "required": true,
      "maxDuration": 10,
      "objectFit": "cover"
    },

    {
      "id": "productImage",
      "type": "image",
      "name": "Zdjęcie produktu",
      "description": "Dodaj zdjęcie produktu",
      "required": true,
      "objectFit": "contain"
    },

    {
      "id": "logo",
      "type": "image",
      "name": "Logo",
      "description": "Dodaj swoje logo",
      "required": false,
      "objectFit": "contain"
    },

    {
      "id": "title",
      "type": "text",
      "name": "Główny tekst",
      "default": "NOWY PRODUKT",
      "required": true,
      "maxLength": 40
    },

    {
      "id": "subtitle",
      "type": "text",
      "name": "Podtytuł",
      "default": "Poznaj nową jakość",
      "required": false,
      "maxLength": 60
    },

    {
      "id": "price",
      "type": "text",
      "name": "Cena",
      "default": "299,99 zł",
      "required": false
    },

    {
      "id": "cta",
      "type": "text",
      "name": "Przycisk CTA",
      "default": "KUP TERAZ",
      "required": true
    }
  ],

  "assets": {

    "fonts": [
      {
        "family": "Inter",
        "weight": 800
      },
      {
        "family": "Inter",
        "weight": 500
      }
    ],

    "music": {
      "enabled": true,
      "placeholder": "Dodaj muzykę",
      "volume": 0.7,
      "fadeIn": 0.5,
      "fadeOut": 1
    }
  },

  "timeline": {

    "tracks": [

      {
        "id": "background",
        "type": "video",
        "name": "Background",

        "clips": [

          {
            "start": 0,
            "duration": 10,
            "source": "mainVideo",

            "transform": {
              "x": 0,
              "y": 0,
              "width": 1080,
              "height": 1920,
              "scale": 1,
              "rotation": 0
            },

            "effects": [
              {
                "type": "blur",
                "start": 0,
                "end": 1,
                "amount": 8
              },

              {
                "type": "brightness",
                "start": 0,
                "end": 10,
                "amount": 0.9
              }
            ]
          }
        ]
      },


      {
        "id": "product",
        "type": "media",
        "name": "Product",

        "clips": [

          {
            "start": 1.2,
            "duration": 5,

            "source": "productImage",

            "transform": {
              "x": 540,
              "y": 950,
              "width": 850,
              "height": 850,
              "scale": 0.7,
              "rotation": 0
            },

            "animation": {
              "in": {
                "type": "scale",
                "duration": 0.8,
                "from": 0.2,
                "to": 1,
                "easing": "easeOutBack"
              },

              "out": {
                "type": "fade",
                "duration": 0.5
              }
            },

            "shadow": {
              "enabled": true,
              "blur": 40,
              "opacity": 0.5
            }
          }
        ]
      },


      {
        "id": "titleTrack",
        "type": "text",
        "name": "Title",

        "clips": [

          {
            "start": 0.4,
            "duration": 3,

            "text": "{{title}}",

            "style": {
              "fontFamily": "Inter",
              "fontSize": 105,
              "fontWeight": 800,
              "color": "#FFFFFF",
              "align": "center",
              "letterSpacing": -2,
              "lineHeight": 1
            },

            "transform": {
              "x": 540,
              "y": 350,
              "width": 950,
              "height": 180
            },

            "animation": {

              "in": {
                "type": "slideUp",
                "duration": 0.7,
                "distance": 120,
                "easing": "easeOutCubic"
              },

              "out": {
                "type": "fade",
                "duration": 0.4
              }
            }
          }
        ]
      },


      {
        "id": "subtitleTrack",
        "type": "text",
        "name": "Subtitle",

        "clips": [

          {
            "start": 1.2,
            "duration": 3,

            "text": "{{subtitle}}",

            "style": {
              "fontFamily": "Inter",
              "fontSize": 42,
              "fontWeight": 500,
              "color": "#DDDDDD",
              "align": "center"
            },

            "transform": {
              "x": 540,
              "y": 500,
              "width": 900,
              "height": 100
            },

            "animation": {

              "in": {
                "type": "fade",
                "duration": 0.8
              },

              "out": {
                "type": "fade",
                "duration": 0.4
              }
            }
          }
        ]
      },


      {
        "id": "priceTrack",
        "type": "text",
        "name": "Price",

        "clips": [

          {
            "start": 4.5,
            "duration": 2.5,

            "text": "{{price}}",

            "style": {
              "fontFamily": "Inter",
              "fontSize": 90,
              "fontWeight": 800,
              "color": "#FFFFFF",
              "align": "center"
            },

            "transform": {
              "x": 540,
              "y": 1350,
              "width": 800,
              "height": 150
            },

            "animation": {

              "in": {
                "type": "pop",
                "duration": 0.5,
                "scale": 0.4,
                "overshoot": 1.2
              }
            }
          }
        ]
      },


      {
        "id": "logoTrack",
        "type": "image",
        "name": "Logo",

        "clips": [

          {
            "start": 0.2,
            "duration": 9.3,

            "source": "logo",

            "transform": {
              "x": 70,
              "y": 70,
              "width": 220,
              "height": 120
            },

            "animation": {

              "in": {
                "type": "fade",
                "duration": 0.5
              }
            }
          }
        ]
      },


      {
        "id": "ctaTrack",
        "type": "button",
        "name": "CTA",

        "clips": [

          {
            "start": 6.5,
            "duration": 3,

            "text": "{{cta}}",

            "transform": {
              "x": 540,
              "y": 1650,
              "width": 650,
              "height": 150
            },

            "style": {

              "background": "#FFFFFF",
              "color": "#000000",

              "borderRadius": 35,

              "fontFamily": "Inter",
              "fontSize": 48,
              "fontWeight": 800,

              "align": "center"
            },

            "animation": {

              "in": {
                "type": "slideUp",
                "duration": 0.6,
                "distance": 100,
                "easing": "easeOutBack"
              },

              "hover": {
                "type": "scale",
                "scale": 1.05
              }
            }
          }
        ]
      },


      {
        "id": "particles",
        "type": "effect",

        "clips": [

          {
            "start": 0,
            "duration": 10,

            "effect": {

              "type": "particles",

              "count": 30,

              "speed": 0.4,

              "size": {
                "min": 2,
                "max": 8
              },

              "opacity": 0.3
            }
          }
        ]
      }
    ]
  },


  "transitions": [

    {
      "start": 3.5,
      "duration": 0.5,
      "type": "flash",
      "intensity": 0.5
    },

    {
      "start": 6,
      "duration": 0.5,
      "type": "zoom"
    },

    {
      "start": 9.5,
      "duration": 0.5,
      "type": "fadeOut"
    }
  ],


  "audio": {

    "music": {
      "source": "musicPlaceholder",
      "start": 0,
      "duration": 10,
      "volume": 0.7,

      "fadeIn": 0.5,
      "fadeOut": 1
    },

    "soundEffects": [

      {
        "type": "whoosh",
        "start": 0.4,
        "volume": 0.5
      },

      {
        "type": "pop",
        "start": 4.5,
        "volume": 0.6
      },

      {
        "type": "click",
        "start": 6.5,
        "volume": 0.5
      }
    ]
  },


  "export": {

    "duration": 10,

    "fps": 30,

    "format": "mp4",

    "videoCodec": "h264",

    "audioCodec": "aac",

    "quality": "high"
  }
}
